# Copy to .env.local and fill in from Supabase → Project Settings → API Keys.
# Both values are public by design (they are sent to the browser).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Social sign-in providers you have switched on in Supabase, comma separated.
# Leave empty until they are configured, e.g. NEXT_PUBLIC_AUTH_PROVIDERS=google,apple
NEXT_PUBLIC_AUTH_PROVIDERS=

# ---- Server-only secrets (never prefix these with NEXT_PUBLIC_) ----
# Supabase → Project Settings → API Keys → Secret keys. Lets the server mark accounts as paid.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Stripe → Developers → API keys (use test mode keys while developing)
STRIPE_SECRET_KEY=sk_test_xxx
# From `stripe listen` locally, or the webhook endpoint you add in the Stripe dashboard
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ---- Private Live Data page (personal use only) ----
# Login emails allowed to see /live, comma separated
OWNER_EMAILS=you@example.com
# Your own PointsYeah login token (see README in the /live section)
POINTSYEAH_REFRESH_TOKEN=
